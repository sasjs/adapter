#!/bin/sh
RED="\033[1;31m"
GREEN="\033[1;32m"

# Get the commit message (the parameter we're given is just the path to the
# temporary file which holds the message).
commit_message=$(cat "$1")

# Only the subject reaches the squashed commit's body, so that is what gets
# checked - see the marker check below.
subject=$(printf '%s\n' "$commit_message" | head -n 1)

# semantic-release's own release commit is `chore(release): X [skip ci]`. It is
# pushed straight to the release branch, never squash-merged, so the marker is
# harmless there and is allowed through.
if (echo "$subject" | grep -Eq "^chore\(release\): ") then
   echo "${GREEN} ✔ Release commit written by semantic-release"
   exit 0
fi

# `[skip release]` and `[skip ci]` must not appear in a commit subject. GitHub
# builds the squashed commit's body from the list of subjects, and both markers
# act on the WHOLE squashed commit rather than on the one commit that carries
# them: semantic-release drops any commit whose message matches `[skip release]`
# (lib/definitions/plugins.js), and `[skip ci]` makes GitHub skip the
# push-triggered workflow outright. Either one silently suppresses the release
# for the entire PR.
#
# This is not hypothetical. @sasjs/utils#274 carried two `chore(ci): ...
# [skip release]` subjects, so the squashed commit on main was filtered out
# whole, the crypto fix merged, and no version was ever published.
# Mirrors the upstream filters rather than a subset of them:
#   - semantic-release drops any commit matching
#     /\[skip\s+release]|\[release\s+skip]/i (lib/definitions/plugins.js), so the
#     match is case-insensitive and accepts any run of whitespace
#   - GitHub skips the push or pull_request run entirely for [skip ci],
#     [ci skip], [no ci], [skip actions] and [actions skip], case-insensitively
# A narrower pattern let "[SKIP RELEASE]" and "[release skip]" through, and both
# still suppressed the release.
if (echo "$subject" | grep -Eqi "\[(skip\s+release|release\s+skip|skip\s+ci|ci\s+skip|no\s+ci|skip\s+actions|actions\s+skip)\]") then
   echo "${RED}❌ The commit subject carries a skip marker!"
   echo "Under squash-merge that suppresses the release for the whole PR, not"
   echo "just this commit, and [skip ci] stops the workflow running at all."
   echo "Drop the marker - a conventional type is enough:"
   echo "  chore(deps): refresh the lockfile"
   exit 1
fi

if (echo "$subject" | grep -Eq "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9 -\*]+\))?!?: .+$") then
   echo "${GREEN} ✔ Commit message meets Conventional Commit standards"
   exit 0
fi

echo "${RED}❌ Commit message does not meet the Conventional Commit standard!"
echo "An example of a valid message is:"
echo "  feat(login): add the 'remember me' button"
echo "ℹ More details at: https://www.conventionalcommits.org/en/v1.0.0/#summary"
exit 1
