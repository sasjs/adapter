#!/bin/sh
RED="\033[1;31m"
GREEN="\033[1;32m"

# Get the commit message (the parameter we're given is just the path to the
# temporary file which holds the message).
commit_message=$(cat "$1")

if (echo "$commit_message" | grep -Eq "^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9 -\*]+\))?!?: .+$") then
   :
else
   echo "${RED}❌ Commit message does not meet the Conventional Commit standard!"
   echo "An example of a valid message is:"
   echo "  feat(login): add the 'remember me' button"
   echo "ℹ More details at: https://www.conventionalcommits.org/en/v1.0.0/#summary"
   exit 1
fi

# semantic-release releases only feat, fix and perf, plus any type carrying a
# breaking `!`. Every other type merges without a release, which leaves the
# publish job with nothing to publish - so say so, and require the author to
# opt out in the message when that is what they intend.
# `[skip ci]` is accepted alongside `[skip release]` because the release commit
# semantic-release writes itself is a `chore` that carries it.
if (echo "$commit_message" | grep -Eq "^(feat|fix|perf)(\([a-z0-9 -\*]+\))?!?: .+$") then
   echo "${GREEN} ✔ Commit message meets Conventional Commit standards"
   exit 0
fi

if (echo "$commit_message" | grep -Eq "\[skip (release|ci)\]") then
   echo "${GREEN} ✔ Conventional commit, marked as not for release"
   exit 0
fi

echo "${RED}❌ Commit type would not produce a release!"
echo "semantic-release releases only feat, fix and perf (or a breaking ! change)."
echo "If this commit is not meant to release, say so in the message:"
echo "  chore(deps): refresh the lockfile [skip release]"
exit 1
