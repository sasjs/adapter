{
  "name": "@sasjs/adapter",
  "description": "JavaScript adapter for SAS",
  "homepage": "https://adapter.sasjs.io",
  "scripts": {
    "nodeVersionMessage": "echo \u001b[33m make sure you are running node lts version \u001b[0m",
    "build": "npm run nodeVersionMessage && npx rimraf build node && npx tsc -p tsconfig.build.json && node createNodeEntry.js && node release/bundle-check.mjs --source-only && webpack && node release/bundle-check.mjs",
    "package:lib": "npm run build && cp ./package.json ./README.md ./LICENSE ./DISCLOSURE build/ && cd build && npm pack",
    "publish:lib": "npm run package:lib && cd build && npm stage publish",
    "lint:fix": "npx prettier --log-level silent --write \"src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\" && npx prettier --log-level silent --write \"sasjs-tests/src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\" && npx prettier --log-level silent --write \"cypress/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\"",
    "lint": "npx prettier --check \"src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\" && npx prettier --check \"sasjs-tests/src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\" && npx prettier --check \"cypress/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\"",
    "lint:silent": "npx prettier --log-level silent --check \"src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\" && npx prettier --log-level silent --check \"sasjs-tests/src/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\" && npx prettier --log-level silent --check \"cypress/**/*.{ts,tsx,js,jsx,html,css,sass,less,json,yml,md,graphql}\"",
    "test": "jest --silent --coverage",
    "publishInit": "cp -r ./build/* . && rm -rf ./build",
    "typedoc": "node createTSDocs",
    "cypress": "cypress open",
    "cy:run": "cypress run"
  },
  "publishConfig": {
    "access": "public"
  },
  "contentPolicy": {
    "class": "dual-use"
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version --allow-same-version"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "keywords": [
    "sas",
    "viya",
    "sasjs"
  ],
  "author": "support@4gl.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/adapter.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@cypress/webpack-preprocessor": "8.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pem": "1.14.4",
    "cors": "2.8.6",
    "cypress": "16.2.0",
    "deepmerge": "file:./vendor/deepmerge",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-extended": "7.0.0",
    "pem": "1.14.8",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-rename-defaults": "0.7.3",
    "typescript": "5.9.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "/index.js",
    "/index.d.ts",
    "DISCLOSURE",
    "/ContextManager.*",
    "/SAS9ApiClient.*",
    "/SASViyaApiClient.*",
    "/SASjs.*",
    "/SASjsApiClient.*",
    "/SessionManager.*",
    "/api/**",
    "/auth/**",
    "/file/**",
    "/job-execution/**",
    "/minified/**",
    "/request/**",
    "/types/**",
    "/utils/**",
    "/dist/**",
    "/node/**",
    "!**/*.spec.d.ts",
    "!**/spec/**",
    "!**/test/**",
    "!**/__mocks__/**",
    "!src/**",
    "!release/**",
    "!node_modules/**"
  ],
  "dependencies": {
    "@sasjs/utils": "^4.1.0",
    "axios": "1.20.0",
    "axios-cookiejar-support": "5.0.5",
    "form-data": "4.0.6",
    "tough-cookie": "6.0.2"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "es-define-property": "npm:@socketregistry/es-define-property@1.0.7",
    "es-set-tostringtag": "npm:@socketregistry/es-set-tostringtag@1.0.10",
    "function-bind": "npm:@socketregistry/function-bind@1.0.7",
    "glob": "14.0.3",
    "gopd": "npm:@socketregistry/gopd@1.0.7",
    "has-symbols": "npm:@socketregistry/has-symbols@1.0.7",
    "has-tostringtag": "npm:@socketregistry/has-tostringtag@1.0.7",
    "hasown": "npm:@socketregistry/hasown@1.0.7",
    "is-core-module": "npm:@socketregistry/is-core-module@1.0.11",
    "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@1.0.5",
    "isarray": "npm:@socketregistry/isarray@1.0.8",
    "minimatch": "11.0.4",
    "object-assign": "npm:@socketregistry/object-assign@1.0.5",
    "path-parse": "npm:@socketregistry/path-parse@1.0.8",
    "safe-buffer": "npm:@socketregistry/safe-buffer@1.0.9",
    "safer-buffer": "npm:@socketregistry/safer-buffer@1.0.10",
    "side-channel": "npm:@socketregistry/side-channel@1.0.10"
  },
  "version": "0.0.0-semantically-released",
  "engines": {
    "node": ">=22"
  },
  "browser": "./dist/sasjs-adapter.js"
}
